GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

VF_DATA_DIR=data
VF_API_BASE=http://localhost:8000

VF_EXTRACTION_MODEL=gemini-1.5-flash
VF_RECONCILIATION_MODEL=gemini-1.5-flash
VF_EMBEDDING_MODEL=text-embedding-004

VF_CHUNK_MAX_CHARS=6000
VF_CHUNK_OVERLAP_RATIO=0.12

VF_MIN_CONFIDENCE=0.30

VF_SIMILARITY_THRESHOLD=0.62
VF_CANDIDATES_PER_FACT=6
VF_MAX_CLUSTER_SIZE=5

VF_CHUNK_CONCURRENCY=5
VF_DOCUMENT_CONCURRENCY=3
VF_RECONCILE_CONCURRENCY=5
